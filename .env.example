# Copy to .env and fill in values. Never commit the real .env file.

# Selects the warehouse backend: "postgres" (local/docker-compose) or
# "snowflake" (AWS demo session). Same code, no branching required.
WAREHOUSE_BACKEND=postgres

# Postgres — local offline-store stand-in for Snowflake
POSTGRES_USER=dev
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
# 5433, not 5432 — the container publishes on 5433 to avoid clashing
# with any Postgres already running natively on the host.
POSTGRES_PORT=5433
POSTGRES_DB=marketplace_dw

# Snowflake — only needed when WAREHOUSE_BACKEND=snowflake
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=

# Airflow metadata database (separate from the warehouse above)
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=change_me
AIRFLOW_POSTGRES_DB=airflow

# MLflow -- local Docker MLflow tracking server (Phase 5 experimentation,
# infra/docker-compose.mlflow.yml). Only this URL changes when training
# later moves to EC2 -- training/ code never hardcodes it.
MLFLOW_TRACKING_URI=http://localhost:5001
